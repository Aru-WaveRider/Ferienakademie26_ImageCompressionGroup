# Upstream checkouts -- fetched by `make sources`, not ours to commit. Each one
# contains its own .git, so committing them would create broken gitlinks anyway.
third_party/

# Pretrained checkpoints: ~1.4 GB, each with its own license, and re-fetchable
# with `make weights`. The directory itself IS tracked (via .gitkeep) so the
# bind mount has somewhere to land on a fresh clone.
# Note the trailing /* -- a bare `weights/` would stop git descending into the
# directory at all, and the negation below would never be reached.
weights/*
!weights/.gitkeep
*.pth
*.pth.tar

# Bulk intermediates: reconstructed .yuv, bitstreams, per-frame PNGs. Hundreds
# of MB, all regenerated by `make experiments`. The figures and RD tables that
# matter live in results/, which IS committed. Directory kept for the same
# bind-mount reason as weights/.
outputs/*
!outputs/.gitkeep

logs/

.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
.vscode/

# Heavy video sequences (Project 02 / 03 test data)
*.yuv
Dataset/*.yuv

# Dataset: Prevent committing large collections of raw .ppm files
Dataset/*.ppm

# Explicitly allow the test .ppm images you want to share with your team:
!Dataset/artificial.ppm